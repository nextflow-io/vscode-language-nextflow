{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2020",
    "lib": ["es2020"],
    "sourceMap": true,
    "strict": true,
    "rootDir": "src",
    "types": []
  },
  "include": ["src"],
  // src/ui is browser code built by Vite, and needs the DOM lib that this
  // config deliberately omits. It is type checked by tsconfig.ui.json.
  "exclude": ["node_modules", ".vscode-test", "src/ui"]
}
