{
  "scopeName": "nextflow.script.injection",
  "injectionSelector": "L:source.nextflow process.nextflow -string.quoted.double.multiline.nextflow -string.quoted.single.multiline.nextflow",
  "patterns": [
    {
      "include": "#script-block"
    },
    {
      "include": "#script-block-single"
    }
  ],
  "repository": {
    "script-block": {
      "name": "string.quoted.double.multiline.nextflow",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        {
          "include": "#embedded-python"
        },
        {
          "include": "#embedded-r"
        },
        {
          "include": "#embedded-shell"
        }
      ]
    },
    "embedded-shell": {
      "begin": "(^|\\G)(?!\\s*$)(?!\\s*\"\"\")",
      "while": "^(?!\\s*\"\"\")",
      "contentName": "meta.embedded.block.shellscript meta.interpolated.nextflow",
      "patterns": [
        {
          "include": "source.shell"
        }
      ]
    },
    "embedded-python": {
      "begin": "(^|\\G)(?=\\s*#!.*\\bpython[\\\\d.]*\\b)",
      "while": "^(?!\\s*\"\"\")",
      "contentName": "meta.embedded.block.python meta.interpolated.nextflow",
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "embedded-r": {
      "begin": "(^|\\G)(?=\\s*#!.*\\b(?:R|Rscript)\\b)",
      "while": "^(?!\\s*\"\"\")",
      "contentName": "meta.embedded.block.r meta.interpolated.nextflow",
      "patterns": [
        {
          "include": "source.r"
        }
      ]
    },
    "script-block-single": {
      "name": "string.quoted.single.multiline.nextflow",
      "begin": "'''",
      "end": "'''",
      "patterns": [
        {
          "include": "#embedded-shell-single"
        }
      ]
    },
    "embedded-shell-single": {
      "begin": "(^|\\G)(?!\\s*''')",
      "while": "^(?!\\s*''')",
      "contentName": "meta.embedded.block.shellscript",
      "patterns": [
        {
          "include": "source.shell"
        }
      ]
    }
  }
}
